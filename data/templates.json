        "faq": {
          "variants": {
            "CleanNestFaq1": {
              "subtitle": "FAQ",
              "title1": "Got Questions?",
              "title2": "We Have Answers",
              "description": "Find answers to the most common questions about our cleaning services, pricing, and procedures.",
              "faqs": [
                {
                  "id": "faq-1",
                  "question": "Do I need to be home during the cleaning?",
                  "answer": "No, you do not need to be home. Many of our clients provide us with a spare key or a garage code. However, if you prefer to be home, that is completely fine with us!"
                },
                {
                  "id": "faq-2",
                  "question": "Do you provide the cleaning supplies?",
                  "answer": "Yes, we bring our own professional-grade, eco-friendly cleaning supplies and equipment. If you prefer us to use your specific products, just let us know."
                },
                {
                  "id": "faq-3",
                  "question": "How do you ensure the quality of your services?",
                  "answer": "Our cleaners undergo rigorous training and background checks. We also have a 100% satisfaction guarantee—if you are not happy with a specific area, let us know within 24 hours, and we will reclean it for free."
                },
                {
                  "id": "faq-4",
                  "question": "Are your cleaning products safe for pets?",
                  "answer": "Absolutely! We use non-toxic, eco-friendly products that are entirely safe for your family and your furry friends."
                },
                {
                  "id": "faq-5",
                  "question": "How can I book a cleaning service?",
                  "answer": "You can easily book a service by calling us, filling out the contact form on our website, or sending us an email. We will get back to you promptly to confirm the details."
                },
                {
                  "id": "faq-6",
                  "question": "What if I need to cancel or reschedule?",
                  "answer": "We understand that plans change. We ask for a 24-hour notice for cancellations or rescheduling to avoid any cancellation fees."
                },
                {
                  "id": "faq-7",
                  "question": "Do you offer one-time cleaning services?",
                  "answer": "Yes, we offer both one-time deep cleaning and recurring cleaning services (weekly, bi-weekly, or monthly)."
                },
                {
                  "id": "faq-8",
                  "question": "How do I pay for the cleaning?",
                  "answer": "We accept all major credit cards, bank transfers, and online payments. Payment is usually processed after the cleaning is completed."
                }
              ]
            }
          }
        },
